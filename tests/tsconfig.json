{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "es2019",
    "lib": ["es6", "dom", "es2017", "es2019"],
    "strict": true,
    "module": "commonjs",
    "types": ["node"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "rootDir": "./",
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["node_modules", "dist"]
}
